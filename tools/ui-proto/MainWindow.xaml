<Window x:Class="UiProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="v2crackN"
        Width="1160" Height="760"
        MinWidth="980" MinHeight="640"
        Background="{DynamicResource 0E1626}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- side navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10"
                                Height="44" Margin="0,2" Padding="12,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="Transparent" HorizontalAlignment="Left"
                                        Margin="0,10,0,10"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource Text2}" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource 101B2E}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pill toggle: track + accent overlay + knob, переключение плавное.
             Финальное состояние задают Setters (мгновенно, даже если анимация
             не отработает), а анимация едет между двумя layout-позициями ноба. -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- ноб не перескакивает по layout: всегда слева, едет только Transform.X (0 → 18) -->
                        <Grid Background="Transparent" Width="42" Height="24">
                            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource 2E3D57}"/>
                            <Border x:Name="TrackOn" CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0"/>
                            <Grid x:Name="KnobHost" Width="18" Height="18"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                  IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource C6CEDC}"
                                         Stroke="{DynamicResource 101A2C}" StrokeThickness="1"/>
                                <Ellipse x:Name="KnobOn" Fill="{DynamicResource FFFFFF}" Opacity="0"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackOn" Property="Opacity" Value="1"/>
                                <Setter TargetName="KnobOn" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobHost"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="0" To="18" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KnobOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobHost"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="18" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KnobOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- строка-радио для выбора способа пинга: подпись слева, кружок справа,
              как ряды-тумблеры; галочка плавно проявляется (как у Toggle) -->
        <Style x:Key="PingRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                            <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Width="20" Height="20">
                                <Ellipse x:Name="Ring" Width="18" Height="18"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="{DynamicResource 2E4466}" StrokeThickness="1.8"/>
                                <Ellipse x:Name="Dot" Width="9" Height="9"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource Accent}" Opacity="0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="0.3" ScaleY="0.3"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.3" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.3" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1" To="0.3" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1" To="0.3" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource 1A2942}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource 2E4466}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B7C5DC}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Emoji" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource 93A4BE}"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>

        <!-- thin dark scrollbar (implicit, window-scoped).
             Track draws the thumb proportionally; with 600+ nodes that is a few px,
             which reads as a clipped button. Give the thumb a real minimum so it
             always looks like a proper handle. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" MinHeight="30">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource 2C3E5C}" CornerRadius="4"
                                                        Margin="3,6" x:Name="ThumbBorder"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PART_Dec" Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PART_Inc" Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PART_Thumb" Property="MinHeight" Value="0"/>
                                <Setter TargetName="PART_Thumb" Property="MinWidth" Value="30"/>
                                <Setter TargetName="PART_Dec" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PART_Inc" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource 22314C}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="14,20,14,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource 13233A}"
                                BorderBrush="{DynamicResource 2E4466}" BorderThickness="1">
                            <TextBlock Text="V2" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2crackN" Foreground="{DynamicResource Text1}"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Proxy Client" Foreground="{DynamicResource Text3}"
                                       FontSize="11"/>
                            <TextBlock x:Name="AppVersion" Text="" Foreground="{DynamicResource Text3}"
                                       FontSize="10" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="8,26,8,0">
                    <RadioButton x:Name="NavConnect" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x23FB;"
                                 Content="Connect" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRouting" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x21C4;"
                                 Content="Routing" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x2699;"
                                 Content="Settings" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x2630;"
                                 Content="Logs" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,18">
                    <TextBlock x:Name="InfoLink" Text="About" Foreground="{DynamicResource Text3}"
                               FontSize="11" Cursor="Help" ToolTipService.ShowDuration="10000"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Column="1" Background="{DynamicResource PageBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="28,20,28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Connect" Foreground="{DynamicResource Text1}"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSub" Text="One tap to protect your traffic"
                               Foreground="{DynamicResource Text2}" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource 12203A}" CornerRadius="20"
                        Padding="13,7" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource 2E4466}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderDot" Width="8" Height="8" Fill="{DynamicResource 5B6478}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderText" Text="Not connected"
                                   Foreground="{DynamicResource C3D0E5}" FontSize="12.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- body -->
            <Grid Grid.Row="1" Margin="28,0,28,16">

                <!-- CONNECT PAGE -->
                <Grid x:Name="PageConnect">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- servers & groups + power -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- server list & subscription groups -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="14">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Servers" Foreground="{DynamicResource Text1}"
                                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="8,4" Cursor="Hand" Tag="auto"
                                                MouseLeftButtonDown="TreeAdd_Click">
                                            <TextBlock Text="+ Добавить" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="8,4" Cursor="Hand" Margin="6,0,0,0" Tag="group"
                                                MouseLeftButtonDown="TreeAdd_Click">
                                            <TextBlock Text="+ Группа" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="8,4" Cursor="Hand" Margin="6,0,0,0"
                                                ToolTip="Update servers" MouseLeftButtonDown="TreeRefresh_Click">
                                            <TextBlock x:Name="TreeRefreshText" Text="⟳" FontSize="13" Foreground="{DynamicResource C3D0E5}"/>
                                        </Border>
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="8,4" Cursor="Hand" Margin="6,0,0,0"
                                                ToolTip="Ping" MouseLeftButtonDown="TreePingAll_Click">
                                            <TextBlock x:Name="TreePingText" Text="⚡" FontSize="12" Foreground="{DynamicResource C3D0E5}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border DockPanel.Dock="Top" Padding="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="TreePingStatus" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" FontSize="11"
                                               Foreground="{DynamicResource Text3}" Text=""/>
                                </Border>                                <!-- filter: поиск сервера по имени / адресу / аннотации -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBox x:Name="TreeFilterBox" Padding="8,5" FontSize="12"
                                             Background="{DynamicResource 101B2E}"
                                             Foreground="{DynamicResource Text1}"
                                             CaretBrush="{DynamicResource C3D0E5}"
                                             BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Search servers — name, address or note"
                                             TextChanged="TreeFilter_Changed"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ServerTree">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <!-- group header -->
                                                    <Border Tag="{Binding Id}" Cursor="Hand"
                                                            Background="{DynamicResource 101B2E}"
                                                            CornerRadius="8" Padding="10,7" Margin="0,0,0,6"
                                                            MouseLeftButtonDown="GroupHeader_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#x1F4CC;" FontFamily="Segoe UI Emoji" FontSize="11"
                                                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding PinMarkVisibility}"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <Border Style="{StaticResource Chip}" Padding="7,3" Margin="8,0,0,0"
                                                                        Visibility="{Binding KindVisibility}">
                                                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource 8FA6C6}" FontSize="10.5"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11.5"
                                                                       Foreground="{DynamicResource Text3}" VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"/>
                                                            <!-- hover actions: update subscription / ping / rename / pin / delete -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                    <Condition Binding="{Binding CanPin}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding ForceActions, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                                    <Condition Binding="{Binding CanPin}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                                        CornerRadius="6" Padding="6,3" Margin="6,0,0,0" Cursor="Hand"
                                                                        Tag="{Binding Id}" ToolTip="Update subscription"
                                                                        Visibility="{Binding SubActionsVisibility}"
                                                                        MouseLeftButtonDown="GroupUpdateSub_Click">
                                                                    <TextBlock Text="⟳" FontSize="11.5" Foreground="{DynamicResource C3D0E5}"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                                        CornerRadius="6" Padding="6,3" Margin="4,0,0,0" Cursor="Hand"
                                                                        Tag="{Binding Id}" ToolTip="Ping all servers in this group"
                                                                        Visibility="{Binding GroupPingVisibility}"
                                                                        MouseLeftButtonDown="GroupPing_Click">
                                                                    <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource C3D0E5}"/>
                                                                </Border>
                                                                <Border Tag="{Binding Id}" Cursor="Hand" Padding="6,3" Margin="6,0,0,0"
                                                                        Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}"
                                                                        BorderThickness="1" CornerRadius="6" VerticalAlignment="Center"
                                                                        ToolTip="Rename group" Visibility="{Binding ManageVisibility}"
                                                                        MouseLeftButtonDown="GroupRename_Click">
                                                                    <TextBlock Text="&#x270E;" FontSize="12" Foreground="{DynamicResource C3D0E5}"/>
                                                                </Border>
                                                                <Border Tag="{Binding Id}" Cursor="Hand" Padding="6,3" Margin="4,0,0,0"
                                                                        BorderBrush="{DynamicResource 2E4466}"
                                                                        BorderThickness="1" CornerRadius="6" VerticalAlignment="Center"
                                                                        ToolTip="Pin to top" Visibility="{Binding PinBtnVisibility}"
                                                                        MouseLeftButtonDown="GroupPin_Click">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource 1A2942}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#x1F4CC;" FontFamily="Segoe UI Emoji" FontSize="12"/>
                                                                </Border>
                                                                <Border Tag="{Binding Id}" Cursor="Hand" Padding="6,3" Margin="4,0,0,0"
                                                                        Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}"
                                                                        BorderThickness="1" CornerRadius="6" VerticalAlignment="Center"
                                                                        ToolTip="Delete group" Visibility="{Binding ManageVisibility}"
                                                                        MouseLeftButtonDown="GroupDelete_Click">
                                                                    <TextBlock Text="&#x1F5D1;" FontFamily="Segoe UI Emoji" FontSize="12"
                                                                               Foreground="{DynamicResource C3D0E5}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <!-- servers of the group -->
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,0,0"
                                                                  Visibility="{Binding ListVisibility}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Tag="{Binding IndexId}" Cursor="Hand"
                                                                        Background="{DynamicResource 0F1728}"
                                                                        BorderBrush="{DynamicResource 22314C}" BorderThickness="1"
                                                                        CornerRadius="8" Padding="8,6" Margin="0,0,0,4"
                                                                        MouseLeftButtonDown="ServerRow_Click">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding ProtocolIcon}" FontFamily="Segoe UI Emoji"
                                                                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                                       Foreground="{DynamicResource Text1}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                                                                       Foreground="{DynamicResource Text3}" Margin="0,1,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Tag="{Binding IndexId}" Cursor="Hand"
                                                                                Background="{DynamicResource 1A2942}"
                                                                                BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                                                CornerRadius="6" Padding="5,2" VerticalAlignment="Center"
                                                                                Margin="0,0,4,0"
                                                                                MouseLeftButtonDown="MoveBtn_Click">
                                                                            <TextBlock Text="&#x21C4;" FontSize="11"
                                                                                       Foreground="{DynamicResource C3D0E5}"/>
                                                                        </Border>
                                                                        <Border Grid.Column="3" Tag="{Binding IndexId}" Cursor="Hand"
                                                                                Background="{DynamicResource 1A2942}"
                                                                                BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                                                CornerRadius="6" Padding="5,2" VerticalAlignment="Center"
                                                                                Margin="0,0,4,0"
                                                                                ToolTip="Rename server"
                                                                                MouseLeftButtonDown="ServerRename_Click">
                                                                            <TextBlock Text="&#x270E;" FontSize="11"
                                                                                       Foreground="{DynamicResource C3D0E5}"/>
                                                                        </Border>
                                                                        <!-- пинг — обычный текст в конце строки (как в Happ) -->
                                                                        <TextBlock Grid.Column="4" MinWidth="46"
                                                                                   TextAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,8,0"
                                                                                   FontSize="11"
                                                                                   Tag="{Binding IndexId}"
                                                                                   Text="{Binding PingText}"
                                                                                   Foreground="{Binding PingBrush}"
                                                                                   ToolTip="Ping"
                                                                                   MouseLeftButtonDown="ServerPing_Click"/>
                                                                        <Border Grid.Column="5" Visibility="{Binding ActiveVisibility}"
                                                                                Background="{DynamicResource 16412E}"
                                                                                BorderBrush="{DynamicResource 2F8A63}" BorderThickness="1"
                                                                                CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="Active" FontSize="10"
                                                                                       Foreground="{DynamicResource 6BECAC}"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="6" Text="&#x203A;" FontSize="14"
                                                                                   Foreground="{DynamicResource Text3}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="No servers yet — use + Server"
                                                               Visibility="{Binding EmptyVisibility}"
                                                               Foreground="{DynamicResource Text3}" FontSize="11.5" Margin="4,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- power -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border Width="186" Height="186" CornerRadius="93"
                                    Background="{DynamicResource 101B2E}" BorderBrush="{DynamicResource 263B58}" BorderThickness="2"
                                    HorizontalAlignment="Center">
                                <Border x:Name="PowerRing" Width="162" Height="162" CornerRadius="81"
                                        Background="{DynamicResource 0D1728}" BorderBrush="{DynamicResource 2E4C77}" BorderThickness="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="PowerBtn" Width="126" Height="126" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Click="Power_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Glow" Background="{DynamicResource 16233A}" CornerRadius="63"
                                                        BorderBrush="{DynamicResource 34527F}" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glow" Property="Background" Value="{DynamicResource 1B2E4B}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Glow" Property="Background" Value="{DynamicResource 13233A}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Path x:Name="PowerIcon" Data="M 12 2 L 12 11 M 7.4 6 A 8 8 0 1 0 16.6 6"
                                              Stroke="{DynamicResource Text2}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform" Width="52" Height="52"/>
                                    </Button>
                                </Border>
                            </Border>

                            <!-- selected server (no pick button) -->
                            <Border Style="{StaticResource Card}" Width="430" Margin="0,20,0,0"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource 16233A}"
                                            BorderBrush="{DynamicResource 2E4466}" BorderThickness="1">
                                        <TextBlock Text="&#x1F1E9;&#x1F1EA;" FontFamily="Segoe UI Emoji"
                                                   Foreground="{DynamicResource A9BAD6}"
                                                   FontSize="18" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="NodeName" Text="Loading server…" Foreground="{DynamicResource Text1}"
                                                       FontSize="14.5" FontWeight="SemiBold"/>
                                            <Border x:Name="NodeProtoChip" Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                    Background="{DynamicResource 16412E}" BorderBrush="{DynamicResource 2F8A63}"
                                                    BorderThickness="1" Padding="9,4">
                                                <TextBlock x:Name="NodeProtoText" Text="VLESS" Foreground="{DynamicResource 6BECAC}" FontSize="11.5"/>
                                            </Border>
                                            <Border x:Name="NodeSecChip"
                                                    Background="{DynamicResource 16412E}" BorderBrush="{DynamicResource 2F8A63}"
                                                    BorderThickness="1" CornerRadius="8" Padding="9,4"
                                                    Margin="6,0,0,0">
                                                <TextBlock x:Name="NodeSecText" Text="Reality" Foreground="{DynamicResource 6BECAC}" FontSize="11.5"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="NodeAddr" Text="… · Selected configuration"
                                                   Foreground="{DynamicResource Text3}" FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- «Тест пинга» — как в Happ: кнопка под карточкой выбранного сервера -->
                            <Border Style="{StaticResource Card}" Width="430" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Accent}" CornerRadius="9"
                                            Padding="12,8" Cursor="Hand"
                                            MouseLeftButtonDown="TestPing_Click">
                                        <TextBlock x:Name="TestPingText" Text="Test ping" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource 0B1220}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TestPingResult" Grid.Column="1" Margin="12,0,2,0"
                                               VerticalAlignment="Center" FontSize="12.5"
                                               Foreground="{DynamicResource C3D0E5}" Text=""/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="StatusText" Text="Not Connected" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text2}"
                                       HorizontalAlignment="Center" Margin="0,22,0,0"/>
                            <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="14"
                                       Foreground="{DynamicResource Text3}"
                                       MaxWidth="620" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>

                            <StackPanel HorizontalAlignment="Center"
                                        Margin="0,24,0,0">
                                <TextBlock Text="CONNECTION MODE" Foreground="{DynamicResource Text3}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Border Width="276" Height="44" CornerRadius="12"
                                        Background="{DynamicResource 14203A}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1">
                                    <Grid x:Name="ModeGrid" Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ModeThumb" Grid.Column="0" CornerRadius="9"
                                                HorizontalAlignment="Left" IsHitTestVisible="False"
                                                Background="{DynamicResource Accent}">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonDown="ModeProxy_Click"/>
                                        <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonDown="ModeTunnel_Click"/>
                                        <TextBlock x:Name="ModeProxyText" Grid.Column="0" Text="Proxy"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource 0B1220}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="ModeTunnelText" Grid.Column="1" Text="Tunnel"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource B7C5DC}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="ModeHint" Visibility="Collapsed"/>

                         <!-- stats (narrow, right side) -->
                        <Grid Grid.Row="1" Grid.Column="1" Width="400" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Download" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                <TextBlock x:Name="DownText" Text="0 B/s" Foreground="{DynamicResource Text1}" FontSize="18"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="Upload" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                <TextBlock x:Name="UpText" Text="0 B/s" Foreground="{DynamicResource Text1}" FontSize="18"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Session" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                <TextBlock x:Name="SessionText" Text="0 B" Foreground="{DynamicResource Text1}" FontSize="18"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>
                    <!-- rename group -->
                    <Popup x:Name="RenamePop" Placement="MousePoint"
                           StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Card}" Padding="10" Width="260">
                            <StackPanel>
                                <TextBlock Text="Rename group" FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="4,0,4,6"/>
                                <TextBox x:Name="RenameBox" Padding="9,6" FontSize="12"
                                         Background="{DynamicResource 101B2E}" Foreground="{DynamicResource Text1}"
                                         CaretBrush="{DynamicResource C3D0E5}"
                                         BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                         KeyDown="RenameBox_KeyDown"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="11,6" Cursor="Hand"
                                            MouseLeftButtonDown="RenameCancel_Click">
                                        <TextBlock Text="Cancel" Foreground="{DynamicResource Text3}" FontSize="12"/>
                                    </Border>
                                    <Border Background="{DynamicResource Accent}" CornerRadius="8" Padding="13,6"
                                            Cursor="Hand" Margin="8,0,0,0"
                                            MouseLeftButtonDown="RenameSave_Click">
                                        <TextBlock Text="Save" Foreground="{DynamicResource 0B1220}" FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- move server to group -->
                    <Popup x:Name="MovePop" Placement="MousePoint"
                           StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Card}" Padding="6" MinWidth="200">
                            <StackPanel>
                                <TextBlock x:Name="MovePopTitle" Text="Move to group" FontSize="11.5"
                                           Foreground="{DynamicResource Text3}" Margin="4,2,4,6"/>
                                <StackPanel x:Name="MoveItems"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- server picker overlay -->
                    <Border x:Name="PickerOverlay" Grid.Row="0" Grid.RowSpan="3"
                            Visibility="Collapsed" Background="{DynamicResource CC0A1120}"
                            MouseLeftButtonDown="PickerBg_Click">
                        <Border Style="{StaticResource Card}" Width="480" MaxHeight="440"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Select server" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="11,5" Cursor="Hand"
                                                MouseLeftButtonDown="AddSubBtn_Click">
                                            <TextBlock Text="+ Subscription" Foreground="{DynamicResource C3D0E5}" FontSize="12"/>
                                        </Border>
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="11,5" Cursor="Hand" Margin="8,0,0,0"
                                                MouseLeftButtonDown="AddServerBtn_Click">
                                            <TextBlock Text="+ Server" Foreground="{DynamicResource C3D0E5}" FontSize="12"/>
                                        </Border>
                                        <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                CornerRadius="8" Padding="11,5" Cursor="Hand" Margin="8,0,0,0"
                                                HorizontalAlignment="Right" MouseLeftButtonDown="PickerBg_Click">
                                            <TextBlock Text="Close" Foreground="{DynamicResource C3D0E5}" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="ImportPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                                        Background="{DynamicResource 0F1728}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                        CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="ImportHint" Foreground="{DynamicResource Text3}" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ImportBox" Grid.Column="0" Padding="9,6" FontSize="12"
                                                     Background="{DynamicResource 101B2E}" Foreground="{DynamicResource Text1}"
                                                     CaretBrush="{DynamicResource C3D0E5}"
                                                     BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                     VerticalContentAlignment="Center"/>
                                            <Border Grid.Column="1" Margin="8,0,0,0"
                                                    Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                    CornerRadius="8" Padding="11,6" Cursor="Hand"
                                                    MouseLeftButtonDown="ImportPaste_Click">
                                                <TextBlock Text="Paste" Foreground="{DynamicResource C3D0E5}" FontSize="12"/>
                                            </Border>
                                            <Border Grid.Column="2" Margin="8,0,0,0"
                                                    Background="{DynamicResource Accent}"
                                                    CornerRadius="8" Padding="13,6" Cursor="Hand"
                                                    MouseLeftButtonDown="ImportAdd_Click">
                                                <TextBlock Text="Add" Foreground="{DynamicResource 0B1220}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Grid.Column="3" Margin="8,0,0,0"
                                                    Background="Transparent" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                    CornerRadius="8" Padding="11,6" Cursor="Hand"
                                                    MouseLeftButtonDown="ImportCancel_Click">
                                                <TextBlock Text="Cancel" Foreground="{DynamicResource Text3}" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ProfileList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Tag="{Binding IndexId}" Cursor="Hand"
                                                        Background="{DynamicResource 0F1728}" BorderBrush="{DynamicResource 22314C}"
                                                        BorderThickness="1" CornerRadius="10"
                                                        Padding="12,10" Margin="0,0,0,8"
                                                        MouseLeftButtonDown="Profile_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource Text1}"
                                                                       FontSize="13.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Foreground="{DynamicResource Text3}"
                                                                       FontSize="11.5" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{Binding ActiveVisibility}"
                                                                Background="{DynamicResource 16412E}" BorderBrush="{DynamicResource 2F8A63}"
                                                                BorderThickness="1" CornerRadius="8"
                                                                Padding="9,4" VerticalAlignment="Center">
                                                            <TextBlock Text="Active" Foreground="{DynamicResource 6BECAC}" FontSize="11"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Border>
                </Grid>
                <Grid x:Name="PageRouting" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12,9" VerticalAlignment="Center">
                            <TextBlock x:Name="RoutingSearchHint" Text="&#x1F50D;  Search presets or domains"
                                       Foreground="{DynamicResource 7E8AA0}" FontSize="12.5"/>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource Accent}"
                                CornerRadius="10" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Padding="14,8"
                                    Cursor="Hand" FontSize="12.5" FontWeight="SemiBold"
                                    Click="NewPreset_Click">
                                <TextBlock x:Name="NewPresetLabel" Text="+  New preset" Foreground="{DynamicResource FFFFFF}"/>
                            </Button>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- presets -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="PresetsTitle" Text="Presets"
                                           Foreground="{DynamicResource Text1}" FontSize="15"
                                           FontWeight="SemiBold" Margin="6,4,6,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PresetList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="64" Margin="6,0"
                                                      MouseLeftButtonDown="PresetRow_Click" Tag="{Binding Id}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="12"
                                                            Background="{DynamicResource 16233A}" BorderBrush="{DynamicResource 2E4466}"
                                                            BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Emoji}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="13,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource Text1}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource Text3}"
                                                                   FontSize="11.5" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}"
                                                              IsChecked="{Binding IsOn}" Tag="{Binding Id}"
                                                              Checked="RoutingToggle_Changed"
                                                              Unchecked="RoutingToggle_Changed"
                                                              VerticalAlignment="Center"/>
                                                    <!-- выбранный для редактирования пресет -->
                                                    <Border Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                                            Margin="-6,10,0,10" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- rules editor -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="RuleEditorTitle" Text="Rules"
                                                   Foreground="{DynamicResource Text1}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,3">
                                            <TextBlock x:Name="RuleCountText" Text="0"
                                                       Foreground="{DynamicResource B7C5DC}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="RuleEditorHint" Text="Select a preset on the left"
                                               Foreground="{DynamicResource Text3}" FontSize="11.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- add rule -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <TextBlock x:Name="AddRuleTitle" Text="Add rule"
                                               Foreground="{DynamicResource Text1}" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border x:Name="RuleTypeDomain" Tag="domain" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5"
                                                MouseLeftButtonDown="RuleType_Click">
                                            <TextBlock Text="Domain" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border x:Name="RuleTypeIp" Tag="ip" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5"
                                                MouseLeftButtonDown="RuleType_Click">
                                            <TextBlock Text="IP" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border x:Name="RuleTypeProcess" Tag="process" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5"
                                                MouseLeftButtonDown="RuleType_Click">
                                            <TextBlock Text="Process" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border x:Name="RuleTypePort" Tag="port" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5"
                                                MouseLeftButtonDown="RuleType_Click">
                                            <TextBlock Text="Port" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RuleValueBox" Padding="9,6" FontSize="12"
                                                 Background="{DynamicResource 1A2942}" Foreground="{DynamicResource Text1}"
                                                 CaretBrush="{DynamicResource C3D0E5}"
                                                 BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="RuleValueBox_KeyDown"/>
                                        <Border Grid.Column="1" Margin="8,0,0,0"
                                                Background="{DynamicResource Accent}" CornerRadius="8"
                                                Padding="13,6" Cursor="Hand"
                                                MouseLeftButtonDown="RuleAdd_Click">
                                            <TextBlock x:Name="AddRuleLabel" Text="Add" Foreground="{DynamicResource 0B1220}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border x:Name="RuleActionProxy" Tag="proxy" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5"
                                                MouseLeftButtonDown="RuleAction_Click">
                                            <TextBlock Text="Proxy" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border x:Name="RuleActionDirect" Tag="direct" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5" Margin="0,0,8,0"
                                                MouseLeftButtonDown="RuleAction_Click">
                                            <TextBlock Text="Direct" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                        <Border x:Name="RuleActionBlock" Tag="block" Cursor="Hand"
                                                Style="{StaticResource Chip}" Padding="10,5" Margin="0,0,8,0"
                                                MouseLeftButtonDown="RuleAction_Click">
                                            <TextBlock Text="Block" Foreground="{DynamicResource C3D0E5}" FontSize="11.5"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="RuleEmpty" Text="No rules yet — add the first one below"
                                                   Foreground="{DynamicResource Text3}" FontSize="12"
                                                   Margin="4,6,0,0" Visibility="Collapsed"/>
                                        <ItemsControl x:Name="RuleList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource 0F1728}"
                                                            BorderBrush="{DynamicResource 22314C}" BorderThickness="1"
                                                            CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="10"
                                                                    Background="{DynamicResource 16233A}"
                                                                    BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Emoji}"
                                                                           FontSize="15"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Value}"
                                                                           Foreground="{DynamicResource Text1}"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           Foreground="{DynamicResource Text3}"
                                                                           FontSize="11" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" CornerRadius="7" Padding="9,3"
                                                                    BorderThickness="1" VerticalAlignment="Center"
                                                                    Margin="8,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource 1A2942}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource 2E4466}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Action}" Value="direct">
                                                                                <Setter Property="Background" Value="{DynamicResource 16412E}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource 2F8A63}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Action}" Value="block">
                                                                                <Setter Property="Background" Value="{DynamicResource BlockBg}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource BlockStroke}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ActionLabel}" FontSize="10.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Action}" Value="direct">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource 6BECAC}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Action}" Value="block">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BlockText}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <CheckBox Grid.Column="3" Style="{StaticResource Toggle}"
                                                                      IsChecked="{Binding Enabled}" Tag="{Binding Id}"
                                                                      Checked="RuleToggle_Changed"
                                                                      Unchecked="RuleToggle_Changed"
                                                                      Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="4" Tag="{Binding Id}" Cursor="Hand"
                                                                    Padding="7,3" Margin="8,0,0,0" CornerRadius="7"
                                                                    BorderThickness="1" VerticalAlignment="Center"
                                                                    BorderBrush="{DynamicResource 2E4466}"
                                                                    Background="{DynamicResource 1A2942}"
                                                                    MouseLeftButtonDown="RuleDelete_Click">
                                                                <TextBlock Text="&#x2715;" FontSize="11"
                                                                           Foreground="{DynamicResource C3D0E5}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- new preset -->
                    <Popup x:Name="NewPresetPop" Placement="MousePoint"
                           StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Card}" Padding="10" Width="280">
                            <StackPanel>
                                <TextBlock x:Name="NewPresetTitle" Text="New preset" FontSize="11.5"
                                           Foreground="{DynamicResource Text3}" Margin="4,0,4,6"/>
                                <TextBox x:Name="NewPresetBox" Padding="9,6" FontSize="12"
                                         Background="{DynamicResource 101B2E}" Foreground="{DynamicResource Text1}"
                                         CaretBrush="{DynamicResource C3D0E5}"
                                         BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                         KeyDown="NewPresetBox_KeyDown"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="11,6" Cursor="Hand"
                                            MouseLeftButtonDown="NewPresetCancel_Click">
                                        <TextBlock x:Name="NewPresetCancel" Text="Cancel" Foreground="{DynamicResource Text3}" FontSize="12"/>
                                    </Border>
                                    <Border Background="{DynamicResource Accent}" CornerRadius="8" Padding="13,6"
                                            Cursor="Hand" Margin="8,0,0,0"
                                            MouseLeftButtonDown="NewPresetCreate_Click">
                                        <TextBlock x:Name="NewPresetCreate" Text="Create" Foreground="{DynamicResource 0B1220}" FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- about program -->
                    <Popup x:Name="AboutPop" Placement="MousePoint"
                           StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource Card}" Padding="16" Width="320">
                            <StackPanel>
                                <TextBlock Text="v2crackN" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AboutVersion" Text="" FontSize="12" Foreground="{DynamicResource Text3}"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="AboutServiceLib" Text="ServiceLib · logic ON" FontSize="11.5"
                                           Foreground="{DynamicResource Text2}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AboutSocks" FontSize="11.5"
                                           Foreground="{DynamicResource Text2}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AboutHttp" FontSize="11.5"
                                           Foreground="{DynamicResource Text2}" Margin="0,0,0,12"/>
                                <TextBlock Text="wifitldev" FontSize="11.5"
                                           Foreground="{DynamicResource Text3}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                            MouseLeftButtonDown="AboutRepo_Click">
                                        <TextBlock Text="GitHub" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                    </Border>
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                            Margin="8,0,0,0" MouseLeftButtonDown="AboutTelegram_Click">
                                        <TextBlock Text="Telegram" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                    </Border>
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                            Margin="8,0,0,0" MouseLeftButtonDown="AboutPc_Click">
                                        <TextBlock Text="PC" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                    </Border>
                                    <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                            Margin="8,0,0,0" MouseLeftButtonDown="AboutMobile_Click">
                                        <TextBlock Text="Mobile" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                    </Border>
                                </StackPanel>
                                <Border Background="Transparent" BorderBrush="{DynamicResource 2E4466}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand"
                                        HorizontalAlignment="Right" MouseLeftButtonDown="AboutClose_Click">
                                    <TextBlock Text="Close" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- SETTINGS PAGE -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Traffic" Style="{StaticResource SectionTitle}" Margin="4,4,0,10"/>
                            <Border Style="{StaticResource Card}" Padding="6,2">
                                <StackPanel>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Tunnel mode" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Route all device traffic through the proxy"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TgTunnel" Grid.Column="1" Style="{StaticResource Toggle}"
                                                  IsChecked="True" Tag="tunnel"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="gVisor network stack" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Better compatibility, slightly slower"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                                                  x:Name="TgGvisor"
                                                  Tag="gvisor"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Local SOCKS port" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="127.0.0.1 — applied on next connect" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <TextBox x:Name="PortBox" Grid.Column="1"
                                                 Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                                 Foreground="{DynamicResource C3D0E5}" CaretBrush="{DynamicResource F2F6FF}" FontSize="12.5"
                                                 Padding="9,5" Width="76" TextAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 KeyDown="PortBox_KeyDown" LostFocus="PortBox_LostFocus"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="HTTP proxy port" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="127.0.0.1 — follows the SOCKS port" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HttpPortText" Grid.Column="1" Text="10809"
                                                   Foreground="{DynamicResource Text2}" FontSize="12.5"
                                                   Padding="9,5" MinWidth="76" TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="4,22,0,10"/>
                            <Border Style="{StaticResource Card}" Padding="6,2">
                                <StackPanel>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Launch at startup" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Start v2crackN when you sign in"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TgAutoRun" Grid.Column="1" Style="{StaticResource Toggle}"
                                                  Tag="autorun"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="System proxy" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Apply the proxy to the whole system"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TgSysProxy" Grid.Column="1" Style="{StaticResource Toggle}"
                                                  Tag="sysproxy"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bypass DPI" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Packet fragmentation for deep packet inspection"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="TgDpi" Grid.Column="1" Style="{StaticResource Toggle}"
                                                  Tag="dpi"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Ping method" Style="{StaticResource SectionTitle}" Margin="4,22,0,10"/>
                            <Border Style="{StaticResource Card}" Padding="6,2">
                                <StackPanel>
                                    <RadioButton x:Name="PingMixed" GroupName="pingmethod" Tag="mixed"
                                                  Style="{StaticResource PingRadio}"
                                                 Checked="PingMethod_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Mixed (all tests)" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="TCP, real ping and UDP in sequence"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <RadioButton x:Name="PingGet" GroupName="pingmethod" Tag="get"
                                                 Style="{StaticResource PingRadio}"
                                                 Checked="PingMethod_Changed">
                                        <StackPanel>
                                            <TextBlock Text="via Proxy GET" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="HTTP GET through the server"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <RadioButton x:Name="PingHead" GroupName="pingmethod" Tag="head"
                                                 Style="{StaticResource PingRadio}"
                                                 Checked="PingMethod_Changed">
                                        <StackPanel>
                                            <TextBlock Text="via Proxy HEAD" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="HTTP HEAD through the server"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <RadioButton x:Name="PingTcp" GroupName="pingmethod" Tag="tcp"
                                                 Style="{StaticResource PingRadio}"
                                                 Checked="PingMethod_Changed">
                                        <StackPanel>
                                            <TextBlock Text="TCP" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="TCP connect to the server address"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <RadioButton x:Name="PingIcmp" GroupName="pingmethod" Tag="icmp"
                                                 Style="{StaticResource PingRadio}"
                                                 Checked="PingMethod_Changed">
                                        <StackPanel>
                                            <TextBlock Text="ICMP" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="ICMP echo to the server address"
                                                       Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="4,22,0,10"/>
                            <Border Style="{StaticResource Card}" Padding="6,2">
                                <StackPanel>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Theme" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock x:Name="ThemeSub" Text="Dark" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Border x:Name="ThemeBtn" Grid.Column="1" Cursor="Hand"
                                                Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="11,6" VerticalAlignment="Center"
                                                MouseLeftButtonDown="ThemeBtn_Click">
                                            <TextBlock x:Name="ThemeBtnText" Text="Dark &#x25BE;"
                                                       Foreground="{DynamicResource C3D0E5}" FontSize="12.5"/>
                                        </Border>
                                        <Popup x:Name="ThemePop" PlacementTarget="{Binding ElementName=ThemeBtn}"
                                               Placement="Bottom" VerticalOffset="6"
                                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Style="{StaticResource Card}" Padding="6" MinWidth="176">
                                                <StackPanel x:Name="ThemeItems"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource 22314C}"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Language" Foreground="{DynamicResource Text1}" FontSize="13.5"/>
                                            <TextBlock Text="Interface language" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Border x:Name="LangBtn" Grid.Column="1" Cursor="Hand"
                                                Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="11,6" VerticalAlignment="Center"
                                                MouseLeftButtonDown="LangBtn_Click">
                                            <TextBlock x:Name="LangBtnText" Text="English &#x25BE;"
                                                       Foreground="{DynamicResource C3D0E5}" FontSize="12.5"/>
                                        </Border>
                                        <Popup x:Name="LangPop" PlacementTarget="{Binding ElementName=LangBtn}"
                                               Placement="Bottom" VerticalOffset="6"
                                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Style="{StaticResource Card}" Padding="6" MinWidth="176">
                                                <StackPanel x:Name="LangItems"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="Transparent" Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- LOGS PAGE -->
                <Grid x:Name="PageLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12,9" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4DC;  Live output: core, ServiceLib and this client"
                                       Foreground="{DynamicResource 7E8AA0}" FontSize="12.5"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                    CornerRadius="9" Padding="13,7" Cursor="Hand"
                                    MouseLeftButtonDown="LogsImport_Click">
                                <TextBlock Text="From file" Foreground="{DynamicResource C3D0E5}" FontSize="12.5"/>
                            </Border>
                            <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                    CornerRadius="9" Padding="13,7" Cursor="Hand" Margin="8,0,0,0"
                                    MouseLeftButtonDown="LogsClear_Click">
                                <TextBlock Text="Clear" Foreground="{DynamicResource C3D0E5}" FontSize="12.5"/>
                            </Border>
                            <Border Background="{DynamicResource 1A2942}" BorderBrush="{DynamicResource 2E4466}" BorderThickness="1"
                                    CornerRadius="9" Padding="13,7" Cursor="Hand" Margin="8,0,0,0"
                                    MouseLeftButtonDown="LogsOpenFolder_Click">
                                <TextBlock Text="Folder" Foreground="{DynamicResource C3D0E5}" FontSize="12.5"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource A8B7D0}"
                                 FontFamily="Consolas" FontSize="12" Padding="6"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsUndoEnabled="False"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- status bar (removed by request) -->
            <Grid Grid.Row="2" Margin="28,0,28,16" Visibility="Collapsed">
                <Border Background="{DynamicResource 0C1526}" CornerRadius="10" Padding="14,9"
                        BorderBrush="{DynamicResource 22314C}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="BarDot" Width="8" Height="8" Fill="{DynamicResource 5B6478}"/>
                            <TextBlock x:Name="BarText" Text="Not connected"
                                       Foreground="{DynamicResource Text2}" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="BarLog" Text="Starting ServiceLib…"
                                   Foreground="{DynamicResource Text3}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SOCKS" Foreground="{DynamicResource Text3}" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="BarPort" Text="127.0.0.1:…" Foreground="{DynamicResource Text2}"
                                       FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- mode-change toast (top center, slides down) -->
        <Border x:Name="ModeToast" Grid.ColumnSpan="2" Panel.ZIndex="100"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" Padding="16,11"
                Background="{DynamicResource 14203A}" BorderBrush="{DynamicResource 2E4466}"
                BorderThickness="1" CornerRadius="12" Visibility="Collapsed"
                IsHitTestVisible="False" MaxWidth="560">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ModeToastShift" Y="-90"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x26A0;" FontFamily="Segoe UI Emoji" FontSize="14"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ModeToastTitle" Text="Reconnect to switch mode"
                               Foreground="{DynamicResource Text1}" FontSize="12.5"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModeToastText"
                               Text="Tunnel and Proxy change only after reconnecting"
                               Foreground="{DynamicResource Text2}" FontSize="11.5"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

