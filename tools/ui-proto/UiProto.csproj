<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\v2rayN\ServiceLib\ServiceLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>v2crackN-UiProto</AssemblyName>
    <RootNamespace>UiProto</RootNamespace>
    <!-- нативные библиотеки (sqlite, skia) внутрь единого exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>v2crackN</AssemblyTitle>
    <Product>v2crackN</Product>
    <Description>v2crackN client backed by ServiceLib 1.1.2 logic</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
